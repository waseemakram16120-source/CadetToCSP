// ============================================================
// CadetToCSP — Cloud Firestore security rules (firestore.rules)
//
// What this does:
//  - users/{uid}: every signed-in user can read and write ONLY
//    their own document (test history, streak, profile, and their
//    leaderboardOptIn flag). Nobody can read or change another
//    aspirant's data, and nobody can list the users collection.
//  - leaderboard/{uid}: a PUBLIC board. Any signed-in user can
//    READ every leaderboard entry, but each user may WRITE only
//    their own leaderboard/{uid} entry (their own name + scores).
//    Leaderboard entries contain ONLY {displayName, totalScore,
//    totalStars, testsTaken, bestScore, streak, updatedAt} —
//    never an email or any private field.
//  - Everything else is denied by default.
//
// How to publish these rules:
//   Option A — Firebase Console (no tools needed):
//     1. Open https://console.firebase.google.com → your project.
//     2. Go to Build → Firestore Database → Rules tab.
//     3. Delete the rules shown there and paste this whole file.
//     4. Click "Publish".
//   Option B — Firebase CLI:
//     firebase deploy --only firestore:rules
//     (run from the folder that contains this file and a
//     firebase.json that points firestore.rules at "rules".)
//
// IMPORTANT: create the database in PRODUCTION MODE first
// (Firestore Database → Create database → "Start in production
// mode"), which denies everything until these rules are
// published. Never publish "allow read, write: if true" —
// that would make every user's data public.
//
// STEP 4 NOTE: if you published the Step 3 rules already, you
// MUST re-publish this updated file — the leaderboard will NOT
// work (permission-denied) until the leaderboard rule below
// is live in the console.
// ============================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // One document per user: users/{uid}
    // Only the signed-in owner of that uid may read or write it.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public leaderboard: users/{uid} stays private, but the board is shared.
    // Any signed-in user can read every entry; each user may write ONLY
    // their own leaderboard/{uid} document (name + scores, never email).
    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default (including listing collections).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
